<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<%- include('_header') %>

<div class="container">
    <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.msg %></div>
    <% } %>

    <h2>👤 个人信息</h2>

    <div class="form-card">
        <h3>基本信息</h3>
        <p>账号：<strong><%= info.username %></strong></p>
        <p>学习积分：<span class="big-num"><%= info.score %></span></p>
        <p>注册时间：<%= info.register_time || '未知' %></p>
    </div>

    <div class="form-card">
        <h3>完善个人资料</h3>
        <form method="post" action="/profile/info">
            <div class="form-row">
                <label>真实姓名</label>
                <input type="text" name="real_name" value="<%= info.real_name || '' %>" placeholder="请输入姓名" maxlength="50">
            </div>
            <div class="form-row">
                <label>性别</label>
                <select name="gender">
                    <option value="" <%= info.gender ? '' : 'selected' %>>不透露</option>
                    <option value="男" <%= info.gender === '男' ? 'selected' : '' %>>男</option>
                    <option value="女" <%= info.gender === '女' ? 'selected' : '' %>>女</option>
                </select>
            </div>
            <div class="form-row">
                <label>电话号码</label>
                <input type="text" name="phone" value="<%= info.phone || '' %>" placeholder="11 位手机号" maxlength="11">
            </div>
            <div class="form-row">
                <label>所在地</label>
                <input type="text" name="location" value="<%= info.location || '' %>" placeholder="例：辽宁省大连市" maxlength="100">
            </div>
            <button class="btn">保存资料</button>
        </form>
    </div>

    <div class="form-card">
        <h3>修改密保问题</h3>
        <p class="muted">当前密保：<%= info.security_question ? info.security_question : '未设置，建议设置以便找回密码' %></p>
        <form method="post" action="/profile/security">
            <div class="form-row">
                <label>密保问题</label>
                <select name="security_question" required>
                    <option value="我的学校是" <%= info.security_question === '我的学校是' ? 'selected' : '' %>>我的学校是</option>
                    <option value="我的家乡是" <%= info.security_question === '我的家乡是' ? 'selected' : '' %>>我的家乡是</option>
                    <option value="我最喜欢的红色景点" <%= info.security_question === '我最喜欢的红色景点' ? 'selected' : '' %>>我最喜欢的红色景点</option>
                    <option value="我母亲的名字" <%= info.security_question === '我母亲的名字' ? 'selected' : '' %>>我母亲的名字</option>
                </select>
            </div>
            <div class="form-row">
                <label>密保答案</label>
                <input type="text" name="security_answer" placeholder="设置新的密保答案" required maxlength="100">
            </div>
            <button class="btn">更新密保</button>
        </form>
    </div>

    <div class="form-card">
        <h3>修改用户名</h3>
        <form method="post" action="/profile/username">
            <div class="form-row">
                <label>新用户名</label>
                <input type="text" name="username" value="<%= info.username %>" minlength="3" required>
            </div>
            <button class="btn">更新用户名</button>
        </form>
    </div>

    <div class="form-card">
        <h3>修改密码</h3>
        <form method="post" action="/profile/password">
            <div class="form-row">
                <label>原密码</label>
                <input type="password" name="oldPwd" required>
            </div>
            <div class="form-row">
                <label>新密码（≥ 6 位）</label>
                <input type="password" name="newPwd" minlength="6" required>
            </div>
            <div class="form-row">
                <label>确认新密码</label>
                <input type="password" name="confirm" minlength="6" required>
            </div>
            <button class="btn">更新密码</button>
        </form>
    </div>

    <div class="form-card">
        <h3>退出登录</h3>
        <p>你随时可以退出当前账号。</p>
        <a class="btn btn-outline" href="/logout">退出登录</a>
    </div>
</div>

<%- include('_footer') %>
</body>
</html>
