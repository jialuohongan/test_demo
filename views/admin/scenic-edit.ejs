<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<%- include('../_header') %>

<div class="container">
    <a class="back-link" href="/scenic/admin/list">← 返回景点列表</a>

    <div class="form-card">
        <h2><%= spot ? '编辑景点' : '新增景点' %></h2>

        <form method="post" action="<%= spot ? '/scenic/admin/edit/' + spot.scenic_id : '/scenic/admin/add' %>">
            <div class="form-row">
                <label>景点名 *</label>
                <input type="text" name="scenic_name" value="<%= spot ? spot.scenic_name : '' %>" required>
            </div>
            <div class="form-row">
                <label>地理位置</label>
                <input type="text" name="location" value="<%= spot ? (spot.location || '') : '' %>" placeholder="例：贵州省遵义市">
            </div>
            <div class="form-row">
                <label>景点描述</label>
                <textarea name="description" rows="3"><%= spot ? (spot.description || '') : '' %></textarea>
            </div>
            <div class="form-row">
                <label>红色历史</label>
                <textarea name="red_history" rows="5" placeholder="景点对应的红色历史事件、人物等"><%= spot ? (spot.red_history || '') : '' %></textarea>
            </div>
            <button class="btn" type="submit">保存</button>
            <a class="btn btn-outline" href="/scenic/admin/list">取消</a>
        </form>
    </div>
</div>

<%- include('../_footer') %>
</body>
</html>
