<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<%- include('../_header') %>

<div class="container">
    <a class="back-link" href="/announcement/admin/list">← 返回公告列表</a>

    <div class="form-card">
        <h2><%= item ? '编辑公告' : '发布公告' %></h2>

        <form method="post" action="<%= item ? '/announcement/admin/edit/' + item.announcement_id : '/announcement/admin/add' %>">
            <div class="form-row">
                <label>标题 *</label>
                <input type="text" name="title" value="<%= item ? item.title : '' %>" required>
            </div>
            <div class="form-row">
                <label>内容</label>
                <textarea name="content" rows="6"><%= item ? (item.content || '') : '' %></textarea>
            </div>
            <div class="form-row">
                <label>发布日期</label>
                <input type="date" name="publish_date" value="<%= item && item.publish_date ? item.publish_date : '' %>">
            </div>
            <div class="form-row">
                <label>备注</label>
                <input type="text" name="remark" value="<%= item ? (item.remark || '') : '' %>">
            </div>
            <button class="btn" type="submit">保存</button>
            <a class="btn btn-outline" href="/announcement/admin/list">取消</a>
        </form>
    </div>
</div>

<%- include('../_footer') %>
</body>
</html>
